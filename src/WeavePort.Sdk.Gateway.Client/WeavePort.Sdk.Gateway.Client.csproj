<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <Description>Bounded authenticated WeavePort remote calls and streams over HTTP/2 TLS.</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WeavePort.Sdk.Client/WeavePort.Sdk.Client.csproj" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <Protobuf Include="gateway.proto" GrpcServices="Both" />
    <Compile Include="../Shared/JsonSize.cs" Link="Internal/JsonSize.cs" />
    <Compile Include="../WeavePort.Sdk.Gateway/Protocol/GatewayMetadata.cs" Link="Internal/GatewayMetadata.cs" />
    <None Include="../../docs/licenses/*.txt" Exclude="../../docs/licenses/grpc-tools-LICENSE.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../docs/package-gateway-client.md" Pack="true" PackagePath="PACKAGE.md" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/FailureCode.cs" Link="Internal/FailureCode.cs" />
    <Compile Include="../Shared/ProtocolContract.g.cs" Link="Internal/ProtocolContract.g.cs" />
  </ItemGroup>
</Project>
