<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <Description>Embedded WeavePort plugin hosting, worker lifecycle and installed artifact resolution.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WeavePort.Abstractions/WeavePort.Abstractions.csproj" />
    <ProjectReference Include="../WeavePort.Sdk.Client/WeavePort.Sdk.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../docs/licenses/tomlyn-LICENSE.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../docs/licenses/chasm-LICENSE.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../docs/package.md" Pack="true" PackagePath="PACKAGE.md" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../compatibility/local-v1.json" LogicalName="WeavePort.LocalCompatibility" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/Cleanup.cs" Link="Internal/Cleanup.cs" />
    <Compile Include="../Shared/SdkOperations.cs" Link="Internal/SdkOperations.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.19.0" />
    <PackageReference Include="Chasm.SemanticVersioning" Version="2.8.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>
</Project>
