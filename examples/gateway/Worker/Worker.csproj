<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UsePackedCore Condition="'$(UsePackedCore)' == ''">true</UsePackedCore>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsePackedCore)' == 'true'">
    <PackageReference Include="WeavePort.Sdk" Version="0.8.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackedCore)' != 'true'">
    <ProjectReference Include="../../../src/WeavePort.Sdk/WeavePort.Sdk.csproj" />
  </ItemGroup>
</Project>
