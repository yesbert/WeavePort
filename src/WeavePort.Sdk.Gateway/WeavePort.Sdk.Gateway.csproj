<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <Description>Host authenticated WeavePort plugin bindings over bounded gRPC HTTP/2 services.</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WeavePort.Sdk.Gateway.Client/WeavePort.Sdk.Gateway.Client.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore.Server" Version="2.83.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/Cleanup.cs" Link="Internal/Cleanup.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/JsonSize.cs" Link="Internal/JsonSize.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../docs/package-gateway.md" Pack="true" PackagePath="PACKAGE.md" />
  </ItemGroup>
</Project>
