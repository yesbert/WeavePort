<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <Description>Author owner-controlled C# plugins for WeavePort.</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../docs/package.md" Pack="true" PackagePath="PACKAGE.md" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/JsonSize.cs" Link="Internal/JsonSize.cs" />
    <Compile Include="../Shared/FailureCode.cs" Link="Internal/FailureCode.cs" />
    <Compile Include="../Shared/ProtocolContract.g.cs" Link="Internal/ProtocolContract.g.cs" />
  </ItemGroup>
</Project>
